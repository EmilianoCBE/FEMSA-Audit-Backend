# Variables extra para el login con Microsoft Entra ID (ver AUTH.md). Las generales están en .env.example.
# Secreto aleatorio de al menos 32 caracteres.
AUTH_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Registrar en Entra como URI de redirección de tipo Web.
ENTRA_REDIRECT_URI=http://127.0.0.1:5173/api/auth/entra/callback
