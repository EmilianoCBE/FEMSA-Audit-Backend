# Agregar estas variables a apps/api/.env, junto con DB_SERVER, DB_NAME, DB_USER y DB_PASSWORD.
WEB_ORIGIN=http://127.0.0.1:5173
# En producción usar production, HTTPS y /api bajo el mismo sitio que la web.
NODE_ENV=development
# Secreto aleatorio de al menos 32 caracteres.
AUTH_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Registrar en Entra como URI de redirección de tipo Web.
ENTRA_REDIRECT_URI=http://127.0.0.1:5173/api/auth/entra/callback
