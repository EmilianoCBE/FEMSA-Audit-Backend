# Copiar a .env y llenar. Las credenciales se comparten por privado; .env nunca se sube a git.
PORT=3000
NODE_ENV=development
# Origen del front (abrir con 127.0.0.1, no localhost). En producción: NODE_ENV=production, HTTPS y /api bajo el mismo sitio.
WEB_ORIGIN=http://127.0.0.1:5173

# Azure SQL
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Login con Microsoft Entra ID: ver .env.auth.example.

# Asistente de IA (US15-US17). mock = sin llamadas externas (pruebas y CI); gemini = modelo real.
AI_PROVIDER=mock
AI_TIMEOUT_MS=8000
GEMINI_API_KEY=
GEMINI_MODEL=
