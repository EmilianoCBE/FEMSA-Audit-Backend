{
  "name": "@femsa-audit/api",
  "private": true,
  "version": "1.0.0",
  "description": "API REST del App Builder de Auditoría Interna FEMSA (Express + Azure SQL)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "auth:migrate": "node scripts/migrate-auth.js",
    "auth:create-user": "node scripts/create-user.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "mssql": "^12.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22"
  }
}
